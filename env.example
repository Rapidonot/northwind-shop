# Local development settings. `make setup` copies this to .env (git-ignored).
# Local dev values only; never put real credentials here.

POSTGRES_USER=northwind
POSTGRES_PASSWORD=northwind-local
POSTGRES_DB=northwind
POSTGRES_PORT=5432

DATABASE_URL=postgresql://northwind:northwind-local@localhost:5432/northwind

# The API key does not go in this file. It lives in ~/.northwind/secrets/anthropic.env (directory
# 0700, file 0600, one line ANTHROPIC_API_KEY=...), outside every checkout. Only the runner reads it.

# LLM record/replay (FOUND-2, decisions 0001 and 0005). Defaults shown; uncomment only to change them.
# LLM_MODE=replay                 # replay | record | live; CI forces replay
# LLM_BUDGET_USD=90               # hard cap on all runtime spend (the $100 credit minus margin);
#                                 # read by the runner, from your terminal
# LLM_MAX_OUTPUT_TOKENS=8192      # max_tokens the factory sets (the CLI would send 128000)
# LLM_LEDGER_PATH=~/.northwind/ledger.jsonl   # one ledger shared by all worktrees
# LLM_ENV_FILE=~/.northwind/secrets/anthropic.env   # the one key file the runner reads
# LLM_PROXY_PORT=<derived from the worktree path>   # dev proxy port (make llm-proxy)
# LLM_RUNNER_PORT=19990           # the key-holding runner (make llm-runner)
#
# A window's run budget has no default: `make llm-runner SUITE=<suite> RUN_BUDGET=<usd>`.
# A 20-call slice is about $4 worst case (Sonnet 5.5, max_tokens 8192, ~15K-token prompt; SPIKE.md §5).
