{
  "permissions": {
    "deny": [
      "Read(~/.northwind/secrets)",
      "Read(~/.northwind/secrets/**)",
      "Edit(~/.northwind/**)",
      "Write(~/.northwind/**)"
    ]
  },
  "sandbox": {
    "filesystem": {
      "denyRead": ["~/.northwind/secrets", "~/.northwind/ledger.lock"],
      "denyWrite": ["~/.northwind"]
    },
    "network": {
      "strictAllowlist": true,
      "allowedDomains": [
        "pypi.org",
        "files.pythonhosted.org",
        "registry.npmjs.org",
        "github.com",
        "api.github.com",
        "*.githubusercontent.com"
      ]
    }
  }
}
