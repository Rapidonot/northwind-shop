{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(~/Projects/northwind-shop/.env*)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Write(./.env)",
      "Write(./.env.*)",
      "Edit(./.claude/settings*)",
      "Write(./.claude/settings*)",
      "Edit(./.claude/hooks/**)",
      "Write(./.claude/hooks/**)",
      "Edit(./.claude/agents/**)",
      "Write(./.claude/agents/**)",
      "Edit(./.claude/skills/**)",
      "Write(./.claude/skills/**)",
      "Edit(./**/.git)",
      "Edit(./**/.git/**)",
      "Edit(~/Projects/northwind-shop/.git/worktrees/**)",
      "Edit(~/Projects/northwind-shop/.git/commondir)",
      "Read(~/.northwind/secrets)",
      "Read(~/.northwind/secrets/**)",
      "Edit(~/.northwind/secrets/**)",
      "Write(~/.northwind/secrets/**)",
      "Edit(~/.northwind/**)",
      "Write(~/.northwind/**)"
    ],
    "allow": ["Bash(make *)", "Bash(uv run *)", "Bash(uv sync*)", "Bash(corepack pnpm *)", "Bash(docker compose *)"],
    "ask": [
      "Bash(git push*)",
      "Bash(make record*)",
      "Bash(make eval-live*)",
      "Bash(make llm-proxy*)",
      "Bash(make *eval-promote*)",
      "Bash(make *eval-gate-stale-ok*)",
      "Bash(uv run *eval-promote*)",
      "Bash(uv run *eval-gate-stale-ok*)",
      "Bash(uv run *northwind_evals*promote*)",
      "Bash(uv run *northwind_llm_replay*promote*)",
      "Bash(make *enrich*)",
      "Bash(uv run *make*enrich*)",
      "Bash(uv run *northwind_evals*enrich*)",
      "Edit(./evals/baselines/**)",
      "Write(./evals/baselines/**)",
      "Edit(./evals/fixtures/known_failures.json)",
      "Write(./evals/fixtures/known_failures.json)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Edit|Write|MultiEdit|NotebookEdit|Grep|Glob",
        "hooks": [
          { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_env.py\"" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "/usr/bin/osascript -e 'display notification \"A session has stopped and is waiting for you\" with title \"Northwind\" sound name \"Glass\"' >/dev/null 2>&1 || true" }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          { "type": "command", "command": "/usr/bin/osascript -e 'display notification \"A session stopped on an error\" with title \"Northwind\" sound name \"Glass\"' >/dev/null 2>&1 || true" }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|idle_prompt|elicitation_dialog",
        "hooks": [
          { "type": "command", "command": "/usr/bin/osascript -e 'display notification \"A session needs your answer\" with title \"Northwind\" sound name \"Glass\"' >/dev/null 2>&1 || true" }
        ]
      }
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "autoAllowBashIfSandboxed": false,
    "filesystem": {
      "denyWrite": [
        "./.claude/settings*",
        "./.claude/hooks",
        "./.claude/agents",
        "./.claude/skills",
        "./.env*",
        "~/.northwind",
        "~/.northwind/secrets",
        "./evals/baselines",
        "./evals/fixtures/known_failures.json",
        "~/Projects/northwind-shop-*/.git",
        "~/Projects/northwind-shop/.git/worktrees/*/gitdir",
        "~/Projects/northwind-shop/.git/worktrees/*/commondir",
        "~/Projects/northwind-shop/.git/worktrees/*/config.worktree",
        "~/Projects/northwind-shop/.git/config.worktree",
        "~/Projects/northwind-shop/.git/commondir",
        "~/Projects/northwind-shop/*/**/.git",
        "~/Projects/northwind-shop-*/*/**/.git"
      ],
      "denyRead": ["./.env*", "~/Projects/northwind-shop/.env*", "~/Library/Keychains", "~/.northwind/secrets", "~/.northwind/ledger.lock"],
      "allowWrite": ["~/.cache/uv", "~/Library/pnpm/store", "/private/tmp/pnpm-store-operation-locks-502"]
    },
    "network": {
      "allowLocalBinding": true
    }
  }
}
