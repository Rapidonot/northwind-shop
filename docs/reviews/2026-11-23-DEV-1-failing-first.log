#!/bin/bash
# DEV-1 evidence, second pass (advisor M3, L1): raw failing-first and mutation output.
# Each step swaps files in place, runs, and restores from a copy saved under a flat name; cmp checks it.
set -u
cd /Users/rapido/Projects/northwind-shop-b || exit 2
SAVE=$(mktemp -d "${TMPDIR:-/tmp}/dev1-ev2.XXXX")
BASE=73454be7b0b8ad72088c2b600215fc0dc0869444
PY=(env LLM_MODE=replay .venv/bin/python -m pytest -p no:cacheprovider -q -rf)
declare -a SAVED=()
save() { local f=$1 flat=${1//\//__}; cp "$f" "$SAVE/$flat" || exit 2; SAVED+=("$f"); }
restore_all() {
	local f flat
	for f in "${SAVED[@]}"; do flat=${f//\//__}; cp "$SAVE/$flat" "$f"; cmp -s "$f" "$SAVE/$flat" || echo "NOT RESTORED $f"; done
	SAVED=()
}
trap restore_all EXIT
echo "# head $(git rev-parse HEAD); files swapped in from $BASE (origin/main, 12b's merge); $(date -u +%FT%TZ)"

echo; echo "## 1. Failing-first: the row's tests against main's implementation files"
IMPL=(Makefile .github/workflows/ci.yml .github/workflows/guard.yml pyproject.toml tools/ship.sh)
for f in "${IMPL[@]}"; do save "$f"; git show "$BASE:$f" >"$f" || exit 2; done
echo "# swapped: ${IMPL[*]} (diff against $BASE now: '$(git diff --stat $BASE -- "${IMPL[@]}" | tail -1)')"
"${PY[@]}" tests/hooks/test_ci_workflow.py \
	tests/hooks/test_ship_marker.py::test_ci_keeps_a_bare_pytest_step \
	tests/hooks/test_ship_marker.py::test_ci_runs_the_integration_tests_serially_with_the_plain_marker \
	tests/hooks/test_make_check.py \
	evals/tests/test_wiring.py::test_ci_integration_step_runs_after_a_unit_failure \
	tests/ship/test_ship.py::test_required_jobs_are_the_jobs_in_the_workflows \
	"tests/ship/test_ship.py::test_a_job_that_did_not_pass_is_refused" -k "not (test_a_job_that_did_not_pass_is_refused and not python-integration)" \
	services/llm-replay/tests/test_runner_support.py::test_a_spending_run_with_real_xdist_workers_refuses_before_any_claim 2>&1 | grep -E '^(FAILED|ERROR)|passed|failed'
restore_all
echo "# restored: '$(git diff --stat HEAD -- "${IMPL[@]}" | tail -1)' (empty = identical to HEAD)"

echo; echo "## 2. The isolation fixes: main's copy of each test file fails where the row's passes"
save evals/tests/test_cli.py; git show "$BASE:evals/tests/test_cli.py" >evals/tests/test_cli.py
echo "# 2a. main's test_cli.py, the three chdir gate tests, each alone and serial:"
for t in test_a_cassette_miss_is_reported_as_stale_not_as_an_error test_the_gate_fails_when_every_call_misses_even_with_the_flag test_a_replay_miss_says_so; do
	printf '%s: ' "$t"; "${PY[@]}" "evals/tests/test_cli.py::$t" 2>&1 | tail -1
done
restore_all
echo "# 2a'. the row's test_cli.py, the same three, each alone and serial:"
for t in test_a_cassette_miss_is_reported_as_stale_not_as_an_error test_the_gate_fails_when_every_call_misses_even_with_the_flag test_a_replay_miss_says_so; do
	printf '%s: ' "$t"; "${PY[@]}" "evals/tests/test_cli.py::$t" 2>&1 | tail -1
done
T=services/llm-replay/tests/test_runner_support.py
save "$T"; git show "$BASE:$T" >"$T"
echo "# 2b. main's test_runner_support.py::test_record_with_no_window_stops_with_the_command_to_open_one under -n 2:"
"${PY[@]}" -n 2 "$T::test_record_with_no_window_stops_with_the_command_to_open_one" 2>&1 | grep -E '^(FAILED|E +|ERROR: a window)|passed|failed' | head -6
restore_all
echo "# 2b'. the row's copy, the same test under -n 2:"
"${PY[@]}" -n 2 "$T::test_record_with_no_window_stops_with_the_command_to_open_one" 2>&1 | tail -1

echo; echo "## 3. Mutations of the security-review fixes (L1-L3), each reverted"
P=services/llm-replay/src/northwind_llm_replay/pytest_plugin.py
save "$P"
python3 -I -c "
from pathlib import Path; p = Path('$P'); t = p.read_text()
a = '    if os.environ.get(\"PYTEST_XDIST_WORKER\") and mode != \"replay\":\n'
assert t.count(a) == 1; p.write_text(t.replace(a, '    if False and mode != \"replay\":  # MUTANT\n'))"
echo "# 3a. L1 mutant: the plugin's xdist refusal disabled ($(git diff --stat -- "$P" | tail -1))"
"${PY[@]}" "$T::test_a_spending_run_with_real_xdist_workers_refuses_before_any_claim" 2>&1 | grep -E '^(FAILED|E +)|passed|failed' | head -4
restore_all
save Makefile; save pyproject.toml
sed -i '' 's|LLM_MODE=record uv run pytest -m ""|LLM_MODE=record uv run pytest -n4 -m ""|' Makefile
sed -i '' 's|^addopts = \["--strict-markers", |addopts = ["--strict-markers", "-n", "2", |' pyproject.toml
echo "# 3b. L2 mutants: -n4 on the record recipe, -n 2 in addopts ($(git diff --stat -- Makefile pyproject.toml | tail -1))"
"${PY[@]}" tests/hooks/test_ci_workflow.py -k 'recipes or addopts' 2>&1 | grep -E '^FAILED|passed|failed'
restore_all
save Makefile
sed -i '' 's|^override PYTEST_PAR := |PYTEST_PAR := |' Makefile
echo "# 3c. L3 mutant: 'override' removed ($(git diff --stat -- Makefile | tail -1))"
"${PY[@]}" tests/hooks/test_ci_workflow.py::test_pytest_par_is_defined_once 2>&1 | grep -E '^FAILED|passed|failed'
printf '# with the mutant, make -n test PYTEST_PAR="-k nothing" runs: '; make -s -n test PNPM=true PYTEST_PAR='-k nothing' 2>/dev/null | grep -o 'uv run pytest.*$'
restore_all
printf '# restored, the same command runs: '; make -s -n test PNPM=true PYTEST_PAR='-k nothing' 2>/dev/null | grep -o 'uv run pytest.*$'
trap - EXIT
echo; echo "# tree after the script: '$(git status --short | tr '\n' ' ')' (empty = clean)"
