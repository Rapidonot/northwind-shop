### probe.mk
OUT ?= $(TMPDIR)/dev1
probe-index:
	uv run python -c "import os, psycopg; from northwind_rag.cli import DEFAULT_DATABASE_URL as D; c=psycopg.connect(os.environ.get('DATABASE_URL', D)); print(c.execute('SELECT index_version, count(*) FROM rag_chunks GROUP BY 1').fetchall())"
probe-unit:
	LLM_MODE=replay uv run pytest -p no:cacheprovider -q --durations=40 --junitxml=$(OUT)/unit.xml $(EXTRA)
probe-integration:
	LLM_MODE=replay uv run pytest -m integration -p no:cacheprovider -q --durations=30 --junitxml=$(OUT)/integration.xml
probe-collect:
	LLM_MODE=replay uv run pytest -p no:cacheprovider -q --collect-only
probe-unit-par:
	LLM_MODE=replay uv run pytest -n auto --dist loadgroup -p no:cacheprovider -q --durations=20 --junitxml=$(OUT)/unit.xml

### run-stages.sh
#!/bin/bash
# DEV-1 instrumented make ci: each stage of `ci` in order, timed; integration through the probe (adds --durations=30).
cd /Users/rapido/Projects/northwind-shop-b || exit 2
OUT=$1; mkdir -p "$OUT"; S=$(dirname "$0")
stage() { local name=$1; shift; local t0=$(date +%s); "$@" >"$OUT/$name.out" 2>&1; local rc=$?; local t1=$(date +%s); printf '%s\t%ss\trc=%s\n' "$name" $((t1-t0)) $rc | tee -a "$OUT/times.tsv"; }
echo "head $(git rev-parse HEAD) start $(date -u +%FT%TZ)" | tee "$OUT/times.tsv"
stage lint make -s lint
stage scan-cassettes make -s scan-cassettes
stage test make test
stage test-integration make -s -f Makefile -f "$S/probe.mk" OUT="$OUT" probe-integration
stage eval-integrity make -s eval-integrity
stage eval-gate make -s eval-gate
stage unit-ci-form make -s -f Makefile -f "$S/probe.mk" OUT="$OUT" probe-unit
stage collect-ci-form make -s -f Makefile -f "$S/probe.mk" OUT="$OUT" probe-collect
echo "end $(date -u +%FT%TZ)" | tee -a "$OUT/times.tsv"

### accept.sh
#!/bin/bash
# DEV-1 acceptance: 3 parallel CI-form unit runs in a row (the CI step's flags), junit per run.
cd /Users/rapido/Projects/northwind-shop-b || exit 2
OUT=$1; mkdir -p "$OUT"
echo "head $(git rev-parse HEAD) start $(date -u +%FT%TZ)" | tee "$OUT/times.tsv"
for i in 1 2 3; do
	t0=$(date +%s)
	make -s -f Makefile -f "$(dirname "$0")/probe.mk" OUT="$OUT/run$i" probe-unit-par >"$OUT/run$i.out" 2>&1
	rc=$?; printf 'run%s\t%ss\trc=%s\t%s\n' $i $(( $(date +%s)-t0 )) $rc "$(grep -E 'passed.* in [0-9.]+s' "$OUT/run$i.out" | tr -d '=' | xargs)" | tee -a "$OUT/times.tsv"
done
echo "end $(date -u +%FT%TZ)" | tee -a "$OUT/times.tsv"

### compare.py
"""DEV-1: compare outcome sets of junit XML runs by (classname, name).

usage: python3 -I compare.py BEFORE.xml AFTER.xml [AFTER2.xml ...]
Prints counts per outcome for each file and every difference against BEFORE. Exit 1 on any difference
or on any failed/errored test in any file.
"""

from __future__ import annotations

import sys
import xml.etree.ElementTree as ET


def outcomes(path: str) -> dict[str, set[str]]:
    sets: dict[str, set[str]] = {k: set() for k in ("passed", "skipped", "xfailed", "failed", "error")}
    for case in ET.parse(path).getroot().iter("testcase"):
        node = f"{case.get('classname')}::{case.get('name')}"
        kids = {child.tag: child for child in case}
        if "failure" in kids:
            kind = "failed"
        elif "error" in kids:
            kind = "error"
        elif "skipped" in kids:
            kind = "xfailed" if kids["skipped"].get("type") == "pytest.xfail" else "skipped"
        else:
            kind = "passed"
        sets[kind].add(node)
    return sets


def main(paths: list[str]) -> int:
    base = outcomes(paths[0])
    base_all = set().union(*base.values())
    bad = 0
    for path in paths:
        cur = outcomes(path)
        counts = ", ".join(f"{k} {len(v)}" for k, v in cur.items())
        print(f"{path}: collected {len(set().union(*cur.values()))}: {counts}")
        if cur["failed"] or cur["error"]:
            bad = 1
            for node in sorted(cur["failed"] | cur["error"]):
                print(f"  FAILED/ERROR {node}")
        if path == paths[0]:
            continue
        cur_all = set().union(*cur.values())
        for node in sorted(base_all - cur_all):
            bad = 1
            print(f"  missing {node}")
        for node in sorted(cur_all - base_all):
            bad = 1
            print(f"  extra {node}")
        for kind in base:
            for node in sorted(base[kind] ^ cur[kind]):
                if node in base_all and node in cur_all:
                    bad = 1
                    was = next(k for k, v in base.items() if node in v)
                    now = next(k for k, v in cur.items() if node in v)
                    if kind == was:
                        print(f"  outcome {node}: {was} -> {now}")
    print("IDENTICAL" if not bad else "DIFFERENT")
    return bad


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))

### accept_compare.py
"""DEV-1 acceptance: each after junit == before junit + exactly the listed additions; shared nodes keep
their outcome; failed = error = none. usage: python3 -I accept_compare.py BEFORE.xml ADDITIONS.txt AFTER.xml..."""
import sys, xml.etree.ElementTree as ET

def outcomes(path):
    res = {}
    for c in ET.parse(path).getroot().iter("testcase"):
        kids = {k.tag: k for k in c}
        kind = ("failed" if "failure" in kids else "error" if "error" in kids else
                ("xfailed" if kids["skipped"].get("type") == "pytest.xfail" else "skipped") if "skipped" in kids else "passed")
        res[(c.get("classname"), c.get("name"))] = kind
    return res

def key(n):
    path, rest = n.split("::", 1); parts = rest.split("::")
    return (".".join([path[:-3].replace("/", ".")] + parts[:-1]), parts[-1])

before = outcomes(sys.argv[1])
adds = {key(l.split("\t", 1)[1].strip()) for l in open(sys.argv[2]) if l.strip()}
bad = 0
for path in sys.argv[3:]:
    after = outcomes(path)
    extra, missing = set(after) - set(before), set(before) - set(after)
    changed = sorted(k for k in set(before) & set(after) if before[k] != after[k])
    fails = sorted(k for k, v in after.items() if v in ("failed", "error"))
    counts = {v: sum(1 for x in after.values() if x == v) for v in ("passed", "skipped", "xfailed", "failed", "error")}
    ok = extra == adds and not missing and not changed and not fails
    bad |= not ok
    print(f"{path.rsplit('/', 2)[-2]}: collected {len(after)} {counts}; added {len(extra)} (listed {len(adds)}, match {extra == adds}); "
          f"missing {len(missing)}; outcome changes {len(changed)}; failed {len(fails)} -> {'OK' if ok else 'DIFFERENT'}")
    for k in sorted(extra ^ adds): print("   addition mismatch", k)
    for k in sorted(missing): print("   missing", k)
    for k in changed: print("   changed", k, before[k], "->", after[k])
    for k in fails: print("   FAILED", k)
    added_out = {after[k] for k in extra}
    print(f"   outcomes of the added tests: {sorted(added_out)}")
print("ACCEPTED" if not bad else "NOT ACCEPTED"); sys.exit(bad)
